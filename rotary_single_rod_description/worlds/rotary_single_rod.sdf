<?xml version="1.0" ?>
<sdf version='1.10'>
  <world name='RotarySingleRod_world'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
  	
    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
      <shadows>true</shadows>
    </scene>
    
    <model name='ground_plane'>
      <static>true</static>
      <link name='ground_link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.800000012 0.800000012 0.800000012 1</ambient>
            <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
            <specular>0.800000012 0.800000012 0.800000012 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
     </model>

    <!--PHYSICAL SYSTEM MODEL-->
    <model name='RotarySingleRod_model' canonical_link='Base'>
      <pose relative_to='ground_plane'>0 0 0 0 0 0</pose>

      <plugin
        filename="gz-sim-apply-joint-force-system"
        name="gz::sim::systems::ApplyJointForce">
        <joint_name>rod_joint</joint_name>
      </plugin>
<!--
      <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <joint_name>rod_joint</joint_name> <topic>/rod_joint/joint_states</topic> 
      </plugin>
-->

     <plugin
        filename="gz-sim-joint-state-publisher-system"
  	name="gz::sim::systems::JointStatePublisher">
     </plugin>

<!--     
      <plugin filename="libJointTorqueSystem.so"
        name="JointTorqueSystem">
        <joint_name>rod_joint</joint_name>
-->

        <!-- <torque1>0.05</torque1>         Nm --> 
        <!-- <duration1>0.5</duration1>    seconds -->
        <!-- <torque2>0.0</torque2>        <Nm -->
        <!-- <duration2>4.5</duration2>     seconds -->
        <!-- <torque3>-0.05</torque3>         Nm -->
        <!-- <duration3>5.0</duration3>     seconds -->  
<!--
	<target_position>1.0</target_position>
	<Ac>-3.0</Ac>
	<Bc>1.0</Bc>
	<Cc>-1.25</Cc>
	<Dc>0.5</Dc>
      </plugin>
-->


      <!--LINKS-->

      <!--BASE LINK-->
      <link name='Base'>
        <pose>0 0 0.15 0 0 0</pose>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.75</radius>
              <length>0.30</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.568 0.675 0.945 1</ambient>
            <diffuse>0.568 0.675 0.945 1</diffuse>
            <specular>0.568 0.675 0.945 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <cylinder>
              <radius>0.75</radius>
              <length>0.30</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>

      <!--MOTOR BODY LINK-->
      <link name='Motor_Body'>
        <pose> 0 0 0.35 0 0 0</pose>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.56 0.941 0.953 1</ambient>
            <diffuse>0.56 0.941 0.953 1</diffuse>
            <specular>0.56 0.941 0.953 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>

      <!--MOTOR SHAFT LINK-->
      <link name='Motor_Shaft'>
        <pose>0 0 0.425 0 0 0</pose>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.0075</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
            <specular>0 0 1 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <cylinder>
              <radius>0.0075</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>

      <!--ROD LINK-->
      <link name='Rod'>
        <pose>0.3 0 0.425 0 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.000417</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0302</iyy>
            <iyz>0</iyz>
            <izz>0.0302</izz>
          </inertia>
          <pose>0 0 0 0 0 0</pose>
        </inertial>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.6 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>1 0 0 1</specular>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.6 0.05 0.05</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <enable_wind>false</enable_wind>
      </link>

      <!--JOINTS-->

      <!--ROD JOINT-->
      <joint name='rod_joint' type='revolute'>
        <pose>-0.3 0 -0.275 0 0 0</pose>
        <parent>Motor_Shaft</parent>
        <child>Rod</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.7976900000000001e+308</lower>
            <upper>1.7976900000000001e+308</upper>
            <effort>inf</effort>
            <velocity>inf</velocity>
            <stiffness>100000000</stiffness>
            <dissipation>1</dissipation>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
            <damping>0</damping>
            <friction>0</friction>
          </dynamics>
        </axis>
      </joint>

      <!--BASE2MOTOR JOINT-->
      <joint name="joint_Base2Motor" type="fixed">
        <pose>0 0 0.3 0 0 0</pose>
        <parent>Base</parent>
        <child>Motor_Body</child>
      </joint>

      <!--MOTOR2SHAFT JOINT-->
      <joint name="joint_Motor2Shaft" type="fixed">
        <pose>0 0 0.4 0 0 0</pose>
        <parent>Motor_Body</parent>
        <child>Motor_Shaft</child>
      </joint>


      <static>false</static>
      <self_collide>false</self_collide>
    </model>


    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.10000000000000001 -0.90000000000000002</direction>
      <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
      <specular>0.200000003 0.200000003 0.200000003 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
  </world>
</sdf>
